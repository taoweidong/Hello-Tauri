        <mxCell id="cmd.f4" value="cli.rs ×1 —— cli_run&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ALLOWED_STEMS：welink-cli, codehub-cli, python/python3/py, systeminfo, ipconfig, tasklist, where, whoami, hostname, nslookup, ping&lt;br&gt;输出 base64 回传，UTF-8→GBK 兜底判定在 TS 侧&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
