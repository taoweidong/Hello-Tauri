        <mxCell id="cmd.f1" value="commands.rs ×9&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;storage_info / storage_migrate / load_config / save_config / read_table(已 @deprecated) / write_table / append_log / open_storage_dir / app_info&lt;br&gt;→ config.json, table.json, logs/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cmd.f2" value="db.rs ×4&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;db_migrate / db_select / db_execute / db_transaction&lt;br&gt;表结构对 Rust 不可见；guard_statement 禁 ATTACH（db.rs:203-213）&lt;br&gt;→ data/app.db（WAL）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmd.f3" value="fs.rs ×2&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fs_read / fs_write（数据根内相对路径）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
