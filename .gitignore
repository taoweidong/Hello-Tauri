# 依赖
node_modules/

# 前端构建产物
dist/

# 打包输出（独立 exe）
release/

# 自动更新发布产物（publish-update.mjs 的三件套：清单/签名/带版本 exe）
publish/

# Tauri / Rust 构建产物（统一输出到项目根 target/，见 .cargo/config.toml）
target/
src-tauri/target/
src-tauri/gen/
**/*.rs.bk
*.pdb
**/mutants.out*/

# 工作区本地数据（AI 会话记忆等）
# 例外：.workbuddy/skills/ 为项目级共享技能，纳入版本管理
.workbuddy/*
!.workbuddy/skills/
.codebuddy/
.impeccable.md

# 历史构建产物目录（误提交产物所在，防止再混入）
build/

# 图标生成的中间产物
vibe_images/

# 本地调试截图与外部视觉工具产物（会话期生成，不纳入版本管理）
.screenshots/
.dsh-vision-toolkit/

# 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# ESLint / 覆盖率产物
coverage/
.eslintcache

# 注意：以下三个是 unplugin 的**生成文件**，但必须提交（P-1）
#   auto-imports.d.ts / components.d.ts / .eslintrc-auto-import.json
# 原因：它们承载 typecheck 与 lint 所需的全局声明，CI 上如果缺了会在
# 「首次构建之前」就失败（typecheck/lint 跑在 build 前面）。不要加进这里。

# ZCode 会话计划（工作笔记，不入库；.zcode/commands 是有意提交的，别动）
.zcode/plans/

# 凭据与私钥（S-13）
# 为什么要显式列出：应用把 CodeHub token / LLM apiKey / RAG apiKey **明文**写进
# 存储根的 config.json（stores/app.ts 的 saveConfig），开发者调试时常把它拷到仓库根。
# 一旦被提交，密钥进git 历史后即使删除文件也仍在。
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.token
# 本项目专有：运行时配置（含明文密钥），文件名固定便于识别
config.json
# 例外：Tauri 的产品配置不是密钥，必须提交
!src-tauri/tauri.conf.json
